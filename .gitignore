# generated datasets are never committed — regenerate via data/generate.py.
# The delivery-guaranteed candidate dataset lives in the committed data/dist/
# (pre-compiled, shipped as-is by the packager); data/out/ stays throwaway scratch.
problems/*/data/out/

# interviewer-only raw extracts — never committed (CLAUDE.md visibility contract);
# lives host-local, consumed by data/generate.py to build the candidate dataset
problems/*/data_raw/

# python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# secrets / host-local config — never committed (CLAUDE.md hard rule)
.env
**/.env
!**/.env.example
# Vertex AI service-account credentials (unillm) — never committed
**/secrets/
your-gcp-project-*.json
*-sa.json
*.iam.gserviceaccount.com.json

# per-candidate session working data — host-local, never committed
# (auditable candidate work lives here as candidate_data/<session>/)
candidate_data/

# retrieved credentials — host-local secrets, NEVER committed (CLAUDE.md hard rule)
cred/

# tooling
.DS_Store
.idea/
.vscode/
