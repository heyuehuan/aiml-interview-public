# Reverse proxy. One proxy fronts everything; internal services are
# never host-exposed. Candidate routes (/ide, /jupyter) are gated by an auth subrequest
# to the portal's /api/authz (the portal enforces real session auth). /admin/* is the admin
# panel. Local dev serves plain HTTP on :80; production adds TLS/443.
{
	admin off
	auto_https off
}

:80 {
	# Proxy's own liveness. Backing services expose their own /healthz too.
	handle /healthz {
		respond "ok" 200
	}

	# Admin panel. Auth is enforced by the app (admin cookie).
	# Match both the bare /admin and everything under it.
	# Guard: candidate containers (compose pins them into 172.29.0.128/25) must not
	# reach the platform front door — a shell in the workspace could otherwise curl the
	# admin panel / portal API through this proxy. Browser traffic arrives via the host
	# NAT gateway (x.x.x.1, outside that range) and is unaffected.
	@admin path /admin /admin/*
	handle @admin {
		@admin_from_candidate remote_ip 172.29.0.128/25
		respond @admin_from_candidate "forbidden" 403
		reverse_proxy admin:8001
	}

	# Portal / session API. Not session-gated — /api/authz lives here (caddy calls
	# it server-side via forward_auth below, so the guard does not affect it).
	handle /api/* {
		@api_from_candidate remote_ip 172.29.0.128/25
		respond @api_from_candidate "forbidden" 403
		reverse_proxy portal:8000
	}

	# Bare -> trailing slash (named matcher so the target isn't read as a matcher).
	# Keeps code-server/JupyterLab under their base path instead of escaping to root.
	@ide_bare path /ide
	redir @ide_bare /ide/ 308
	@jup_bare path /jupyter
	redir @jup_bare /jupyter/ 308

	# VS Code (code-server). Strip the /ide prefix; code-server serves relative assets.
	handle_path /ide/* {
		forward_auth portal:8000 {
			uri /api/authz
		}
		reverse_proxy code-server:8443
	}

	# JupyterLab. base_url=/jupyter, so pass the prefix through (no strip).
	handle /jupyter/* {
		forward_auth portal:8000 {
			uri /api/authz
		}
		reverse_proxy jupyterlab:8888
	}

	# Candidate portal (session-aware home / code entry / terms).
	handle {
		reverse_proxy portal:8000
	}
}
