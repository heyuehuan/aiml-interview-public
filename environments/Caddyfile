# the workspace stack reverse proxy. One proxy fronts everything; internal services
# are never host-exposed. Candidate routes (/ide, /jupyter) are gated by an auth
# subrequest to the portal's /api/authz (the portal provides it; the original portal-stub returns
# 204 = allow until the portal lands lands). Local dev serves plain HTTP on :80; production adds TLS/443.
{
	admin off
	auto_https off
}

:80 {
	# Proxy's own liveness. Backing services expose their own /healthz too.
	handle /healthz {
		respond "ok" 200
	}

	# Portal / session API. Not session-gated — /api/authz lives here.
	handle /api/* {
		reverse_proxy portal-stub:8000
	}

	# Bare -> trailing slash (named matcher so the target isn't read as a matcher).
	# Keeps code-server/JupyterLab under their base path instead of escaping to root.
	@ide_bare path /ide
	redir @ide_bare /ide/ 308
	@jup_bare path /jupyter
	redir @jup_bare /jupyter/ 308

	# VS Code (code-server). Strip the /ide prefix; code-server serves relative assets.
	handle_path /ide/* {
		forward_auth portal-stub:8000 {
			uri /api/authz
		}
		reverse_proxy code-server:8443
	}

	# JupyterLab. base_url=/jupyter, so pass the prefix through (no strip).
	handle /jupyter/* {
		forward_auth portal-stub:8000 {
			uri /api/authz
		}
		reverse_proxy jupyterlab:8888
	}

	# Home page shell (the portal replaces this with the session-aware portal).
	handle {
		reverse_proxy portal-stub:8000
	}
}
