# candidate workspace image: python 3.12 + trimmed tier-1 ML stack + code-server
# + JupyterLab. One image, two roles (code-server / jupyterlab) run from it in
# compose, both mounting the same ~/workspace volume. See infra/images/base-image-spec.md.
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

# Non-Python tooling candidates reach for + build deps for any source wheels.
# gosu: drop from the root entrypoint to the per-session non-root candidate user.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git tmux ripgrep sqlite3 curl jq make gcc g++ ca-certificates procps \
        bash gosu \
    && rm -rf /var/lib/apt/lists/*

# Trimmed tier-1 Python stack.
COPY requirements.workspace.txt /tmp/requirements.workspace.txt
RUN pip install --no-cache-dir -r /tmp/requirements.workspace.txt

# code-server (VS Code OSS server, MIT).
RUN curl -fsSL https://code-server.dev/install.sh | sh

# Python + Jupyter support inside VS Code, from Open VSX (code-server's default
# gallery — license-clean; MS marketplace is off-limits for non-MS products).
# Pinned to tested versions for a deterministic interview image; the top-level two
# pull in their dependencies (debugpy, jupyter-renderers, ...). ipykernel (in the pip
# layer) is the kernel the Jupyter extension runs against.
# Installed into a shared, read-only-friendly dir so any per-session non-root user
# (created at runtime by the entrypoint) picks them up via --extensions-dir.
RUN code-server --extensions-dir /opt/cs/extensions \
        --install-extension ms-python.python@2026.4.0 \
        --install-extension ms-toolsai.jupyter@2025.9.1 \
    && chmod -R a+rX /opt/cs

# Baseline VS Code settings, copied into the candidate's user-data-dir at session start.
RUN mkdir -p /opt/cs && \
    printf '%s\n' \
      '{' \
      '  "python.defaultInterpreterPath": "/usr/local/bin/python",' \
      '  "extensions.autoCheckUpdates": false,' \
      '  "extensions.autoUpdate": false' \
      '}' > /opt/cs/settings.json

# Workspace entrypoint: waits for an active session, creates the non-root candidate user,
# then launches the requested tool as that user.
COPY workspace/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Shared workspace mount point (the candidate volume; wiped on reset).
RUN mkdir -p /data/workspace
WORKDIR /data/workspace

# Internal ports only — nothing is published except through the proxy.
EXPOSE 8443 8888
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
