# Copy to .env for local dev:  cp .env.example .env
# Host port the reverse proxy listens on locally (open http://localhost:<port>).
# Production fronts this on 443/TLS instead.
PROXY_HTTP_PORT=8080

# Profile: dev|prod. "dev" permits the public dev credentials in this file; ANYTHING
# else makes the services refuse to boot on them.
# A production .env must set APP_ENV=prod (or omit it — prod is the default) AND
# override every credential below.
APP_ENV=dev

# --- portal session service / admin panel --------------------------------------
# EVERY value in this section is a credential. The defaults below are public (they are in
# git) — a production host MUST override all of them:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Cookie-signing secret (candidate + admin sessions). Set a long random value in prod.
PORTAL_SECRET=dev-insecure-secret-change-me
# Cookies are marked Secure by default (prod runs behind TLS). Local dev serves plain
# HTTP on localhost, where a Secure cookie would never be stored — so dev sets this to 0.
# OMIT this (or set 1) in any TLS deployment.
COOKIE_SECURE=0
# Initial admin account, seeded into the admins table on first boot.
# For production, prefer ADMIN_PASSWORD_HASH over a plaintext ADMIN_PASSWORD:
#   python environments/portal/hashpw.py 'your-password'
# That prints the whole ADMIN_PASSWORD_HASH= line ready to paste, with every '$' written
# as '$$'. The doubling is required: compose interpolates '$' in .env values, so a hash
# pasted raw arrives with its separators eaten and the seeded admin cannot log in.
# The stack refuses to boot on a mangled hash rather than seeding a dead account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# ADMIN_PASSWORD_HASH=pbkdf2_sha256$$200000$$<salt-hex>$$<digest-hex>
#
# Break-glass admin password: accepted for ANY existing admin username, bypassing the
# password hash. Unset = disabled, which is the default and the right choice unless you
# need it. It exists because seed_admins() uses INSERT OR IGNORE, so changing
# ADMIN_PASSWORD above does NOT update an admin that already exists — without this, an
# owner who loses the password is locked out of their own panel.
# NEVER give this a default in code: a default IS the admin password, and it is public the
# moment someone reads the source.
# ADMIN_MASTER_KEY=

# Candidate-facing URL printed on the admin's PDF handout (Sessions → session →
# "Export PDF handout"). Set it to whatever candidates actually type; local dev usually
# wants http://localhost:8080/. No routing depends on it, but its origin becomes
# JupyterLab's allow_origin, so getting it right is what stops an unrelated site the
# candidate visits from driving their notebook.
PORTAL_PUBLIC_URL=https://interview.example.com/
# Override that derivation only if the candidate's browser origin differs from the URL
# above. Unset here and PORTAL_PUBLIC_URL unset too means allow_origin '*' — fine for
# local dev, wrong everywhere else; the workspace logs a warning when it lands there.
# WORKSPACE_ALLOW_ORIGIN=https://interview.example.com
# Everything else that sheet says — welcome, steps, tool blurbs, footer — is Markdown in
# config/handout.md, re-read on every print. No env var needed to change the wording.

# Instance name shown in the portal header/footer, the handout title and the report
# footer. Anything you like; the default is deliberately generic.
PLATFORM_NAME=Technical Interview Platform

# Only for an instance upgraded from a build without MCQ answer capture: the ISO-8601 UTC
# moment capture went live. Sessions that ended earlier show "Not captured" instead of
# "Not answered". Leave unset on a fresh install.
#MCQ_CAPTURE_SINCE=

# --- LLM proxy (unillm) --------------------------------------------------
# One shared master key that authenticates every request to unillm. Candidates get
# this key in their workspace env; the admin dashboard shows it. Use a long random
# value in prod (e.g. `python -c "import secrets;print('sk-unillm-'+secrets.token_hex(24))"`).
UNILLM_MASTER_KEY=sk-unillm-dev-change-me
# Path (relative to environments/) to the Vertex AI service-account JSON. Mounted into
# the unillm container only; gitignored, never candidate-visible.
GCP_SA_KEY_FILE=./secrets/gcp-sa.json
# Host port unillm is published on (candidates call localhost:<port>; prod domain:<port>).
UNILLM_HOST_PORT=8081
# Candidate-facing base URL injected into the workspace (loopback forwarder → unillm).
LLM_BASE_URL=http://localhost:8081/v1
# Compose-internal base URL the admin Test-Gemini button calls server-side.
UNILLM_INTERNAL_URL=http://unillm:8081/v1
# Cost/DoS guards. Hard ceiling on output tokens per completion (an unset or larger
# max_tokens is clamped to this; 0 disables). Per-key request budget over a rolling 60s
# window (0 disables). Defaults below are the built-in ones — raise/lower per deployment.
UNILLM_MAX_OUTPUT_TOKENS=8192
UNILLM_RATE_LIMIT_PER_MIN=60
