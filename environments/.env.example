# Copy to .env for local dev:  cp .env.example .env
# Host port the reverse proxy listens on locally (open http://localhost:<port>).
# Production fronts this on 443/TLS instead.
PROXY_HTTP_PORT=8080

# --- portal session service / admin panel --------------------------------------
# Cookie-signing secret (candidate + admin sessions). Set a long random value in prod.
PORTAL_SECRET=dev-insecure-secret-change-me
# Initial admin account, seeded into the admins table on first boot.
# For production, prefer ADMIN_PASSWORD_HASH (scrypt) over a plaintext ADMIN_PASSWORD:
#   python environments/portal/hashpw.py 'your-password'
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# ADMIN_PASSWORD_HASH=scrypt$...

# --- LLM proxy (workspace-internal; key never candidate-visible) ---------
# Where the portal issues/revokes per-session keys and what the workspace points SDKs at.
LLM_ADMIN_URL=http://unillm:4000/llm
LLM_BASE_URL=http://unillm:4000/v1
